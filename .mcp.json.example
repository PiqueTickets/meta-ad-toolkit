{
  "mcpServers": {
    "meta-ads": {
      "command": "npx",
      "args": ["-y", "meta-ads-mcp"],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}",
        "META_APP_ID": "${META_APP_ID}",
        "META_CLIENT_SECRET": "${META_CLIENT_SECRET}"
      }
    },
    "meta-ads-write": {
      "command": "node",
      "args": ["./tools/meta-ads-write/dist/src/index.js"],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}",
        "META_APP_ID": "${META_APP_ID}",
        "META_CLIENT_SECRET": "${META_CLIENT_SECRET}"
      }
    }
  }
}
